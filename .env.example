# ---- Edge ----------------------------------------------------------------
# Port, den OpenWebUI anspricht. Nur an localhost binden, wenn OpenWebUI
# auf demselben Host laeuft.
EDGE_BIND=127.0.0.1
EDGE_PORT=8888

# ---- SearXNG -------------------------------------------------------------
# Pflicht. Erzeugen mit: openssl rand -hex 32
SEARXNG_SECRET=changeme-openssl-rand-hex-32

# ---- Filter --------------------------------------------------------------
# spaCy-Modelle, die im Filter-Image installiert werden.
FILTER_SPACY_DE=de_core_news_md
FILTER_SPACY_EN=en_core_web_md
# Sprache, wenn der Aufrufer keine mitgibt: de | en
FILTER_DEFAULT_LANG=de

# ---- Gateway -------------------------------------------------------------
# Was passiert, wenn die Policy blockt:
#   inform -> HTTP 200 mit einem Pseudo-Treffer, der dem LLM den Grund nennt
#   empty  -> HTTP 200 mit leerer Trefferliste
#   error  -> HTTP 422
GATEWAY_BLOCK_RESPONSE=inform

# Was ins Log geht:
#   none     -> gar keine Query
#   redacted -> Query mit ersetzten Fundstellen (Default)
#   hashed   -> nur SHA256 der Original-Query
#   raw      -> Klartext. Hebelt den Zweck des Projekts aus. Nur zum Debuggen.
GATEWAY_LOG_QUERIES=redacted

# Cache fuer bereits gefilterte Queries (Sekunden, 0 = aus)
GATEWAY_CACHE_TTL=900

# Obergrenzen
GATEWAY_MAX_QUERY_LEN=512
GATEWAY_MAX_RESULTS=20
GATEWAY_UPSTREAM_TIMEOUT=20

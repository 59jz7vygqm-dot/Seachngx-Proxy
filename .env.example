# ---- Edge ----------------------------------------------------------------
# Port, den OpenWebUI anspricht. Nur an localhost binden, wenn OpenWebUI
# auf demselben Host laeuft.
EDGE_BIND=127.0.0.1
EDGE_PORT=8888

# ---- SearXNG -------------------------------------------------------------
# Pflicht. Erzeugen mit: openssl rand -hex 32
SEARXNG_SECRET=changeme-openssl-rand-hex-32

# ---- Filter --------------------------------------------------------------
# spaCy-Modelle, die im Filter-Image installiert werden.
FILTER_SPACY_DE=de_core_news_md
FILTER_SPACY_EN=en_core_web_md
# Sprache, wenn der Aufrufer keine mitgibt: de | en
FILTER_DEFAULT_LANG=de

# ---- Gateway -------------------------------------------------------------
# Was passiert, wenn die Policy blockt:
#   inform -> HTTP 200 mit einem Pseudo-Treffer, der dem LLM den Grund nennt
#   empty  -> HTTP 200 mit leerer Trefferliste
#   error  -> HTTP 422
GATEWAY_BLOCK_RESPONSE=inform

# Was ins Log geht:
#   none     -> gar keine Query
#   redacted -> Query mit ersetzten Fundstellen (Default)
#   hashed   -> nur SHA256 der Original-Query
#   raw      -> Klartext. Hebelt den Zweck des Projekts aus. Nur zum Debuggen.
GATEWAY_LOG_QUERIES=redacted

# Cache fuer bereits gefilterte Queries (Sekunden, 0 = aus)
GATEWAY_CACHE_TTL=900

# Obergrenzen
GATEWAY_MAX_QUERY_LEN=512
GATEWAY_MAX_RESULTS=20
GATEWAY_UPSTREAM_TIMEOUT=20

# ---- Telemetrie an aimonitor --------------------------------------------
# Leer = Telemetrie komplett aus. Der Proxy laeuft davon unabhaengig.
AIMON_URL=
# z. B. AIMON_URL=http://aimon.lan:8420/api/v1/ingest/privacy
AIMON_TOKEN=

# Maschine, auf der der Proxy laeuft. Ohne Angabe der Containername, der
# nichts aussagt - also setzen.
AIMON_NODE=
# Default: privacy-proxy@<AIMON_NODE>:8888
AIMON_SERVICE_KEY=
# Default: http://<AIMON_NODE>:8888
AIMON_BASE_URL=

AIMON_INTERVAL=10
AIMON_TIMEOUT=5
AIMON_QUEUE_MAX=5000
AIMON_BATCH_MAX=500

# --- Schalter, die Anfragetext freigeben ---------------------------------
# Beide stehen bewusst auf false. Siehe README, Abschnitt "Telemetrie".
#
# Die geschwaerzte Fassung der Anfrage. Der Filter GARANTIERT NICHT, dass
# danach kein Personenbezug mehr drinsteht - kleingeschriebene Namen rutschen
# durch. Wer das einschaltet, akzeptiert Personenbezug im Dashboard.
AIMON_SEND_REDACTED_QUERIES=false
#
# Die Originalanfrage. Hebelt den Zweck dieses Projekts aus. Der Server muss
# es zusaetzlich mit AIMON_ALLOW_RAW_QUERIES=true erlauben.
AIMON_SEND_RAW_QUERIES=false

# SHA256 der Originalanfrage, damit aimonitor Wiederholungen erkennt, ohne
# den Text zu kennen. Kurze Suchanfragen sind durchprobierbar - ein Salt
# verhindert das, macht Hashes zwischen Installationen aber unvergleichbar.
AIMON_SEND_QUERY_HASH=true
AIMON_QUERY_HASH_SALT=
